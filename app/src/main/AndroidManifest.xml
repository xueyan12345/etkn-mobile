<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 用户口径 #74：离开指定 WiFi 且正在放歌时彻底退出。必须 FINE+COARSE 成对声明。 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 用户口径 #78：要主动 startScan() 才能列出周边所有 WiFi，需要此权限。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 投屏: SSDP discovery of DLNA renderers on the Wi-Fi. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 用户口径（#1 真根因）：ColorOS 的 OplusHansManager 在息屏时冻结进程，
         申请电池优化豁免可减轻冻结。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- App updates: open the downloaded APK in the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 8–9 only: save update APKs into the public Download folder (10+ uses MediaStore). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
    用户口径（2026-11-27，#86）原图直接用，不要系统裁切放大。
    用户原话：「A」—— 选原图原样、方角，不要系统圆角裁切。

    之前用 @mipmap/ic_launcher（adaptive-icon XML）：
        background = 原图
        foreground = 全透明
    系统渲染自适应图标时会对前景层缩放叠加，等效于把原图裁成圆角
    并重新缩放 —— 桌面看到的主体就被放大了。

    现在直接指向 @drawable/ic_launcher_plain（原图 PNG 1024x1024，
    MD5 = 0da16416cf5b，未做任何像素处理）。系统原样显示，不裁不缩。
    代价是图标方角。
-->
<application
        android:name=".EtknApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_launcher_plain"
        android:roundIcon="@drawable/ic_launcher_plain"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Etkn">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Etkn.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                用户口径（2026-11-27，#28A）**让系统把 ETKN 认成音乐播放器**。

                这两个 intent-filter 缺一个，系统就不会把 App 列进对应的入口：
                ① APP_MUSIC —— 系统「音乐」默认应用列表、数字助理的音乐源里能看到 ETKN
                ② VIEW + audio/* —— 文件管理器/聊天工具里点一个音频文件，「打开方式」里能选 ETKN

                注意 APP_MUSIC 是独立 filter，不能和 LAUNCHER 合并：
                合并会让桌面图标和音乐入口绑死，部分 ROM 会重复显示两个图标。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name=".launcher.ResumeWidget"
            android:exported="false"
            android:label="@string/widget_resume">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_resume_info" />
        </receiver>

        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:alwaysRetainTaskState="true"
            android:screenOrientation="unspecified"
            android:supportsPictureInPicture="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Etkn.Player">
            <!--
                用户口径（2026-11-26）**OPPO Pad Mini 系统横屏的正解**。

                Android 16 官方行为变更（原文）：
                  「For apps targeting Android 16 (API level 36), orientation,
                    resizability, and aspect ratio restrictions no longer apply
                    on displays with smallest width >= 600dp.」
                且明确列出被忽略的 API：screenOrientation、resizableActivity、
                setRequestedOrientation()、getRequestedOrientation()。

                官方给出的退出方式（原文）：
                  「Every app that isn't fully ready can temporarily override this
                    behavior by opting out, which results in the previous behavior
                    of being placed in compatibility mode.」
                  属性名 = android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY

                ⚠️ 之前这里写的是 PROPERTY_COMPAT_ALLOW_ORIENTATION_OVERRIDE，
                **这个属性名不存在**（官方文档里没有），所以系统一直没理我们的方向请求，
                日志里才会一直是 round=1/2/3 want=L real=P ok=false。

                加上这个正确的属性后：
                 · 系统重新尊重 setRequestedOrientation
                 · 可以直接系统级横屏（不需要画布旋转）
                 · 画面可以走 SurfaceView 直通 → 杜比视界元数据不丢 → 不偏色
                 · 旋转和偏色两个问题一起解决

                注：官方说明这个 opt-out 是临时的，targetSdk 37 时会失效；
                但当前 targetSdk=36，可用。
            -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <service
            android:name=".player.VideoPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
            用户口径（2026-11-27，#28A）**耳机/蓝牙线控按键**。

            Media3 的 MediaButtonReceiver 把系统媒体按键转发给正在播放的 MediaSession，
            没有这个声明，插着耳机的播放/暂停键按了没反应。
        -->
        <!--
            用户口径（2026-11-27，#69）**自己的 MediaButtonReceiver**。

            为什么不用 Media3 官方那个：实测 force-stop 后按媒体键，
            系统会把广播转成 startService，但**不带原始 Intent**，
            我们的 onStartCommand 拿不到 keyCode，于是"唤醒了但不出声"
            （adb 证据：onPlaybackResumption 与 onPlayerCommandRequest 都没被调用，
            状态停在 PAUSED）。

            自定义 Receiver 在转发给 Media3 之前，先把 keyCode 存进
            MediaButtonHint（同进程静态变量），Service 起来后读它就知道
            用户按的是播放还是下一首，然后决定是"开始播"还是放手。
        -->
        <receiver
            android:name=".music.EtknMediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".music.MusicService"
            android:exported="true"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback">
            <!--
                用户口径（2026-11-28，#190）`stopWithTask="false"` **必须显式写死**。

                adb 实测（两次启动对比）：
                  第1次 pid=18742  fgState=2 → 0   活了 5.9 秒（用户杀才停）
                  第2次 pid=19089  fgState=2 → 0   只活 60 毫秒自己停了
                  随后 addSession(19.670) → removeSession(19.702)，32ms 就销毁，
                  之后再无 addSession → 控制中心「等多长时间都不显示」。

                根因是 `onTaskRemoved` 里 `if (!playWhenReady) { stopSelf() }` ——
                打开 App 时音乐是暂停的，一划掉后台服务就自杀。
                代码已一并修掉，这里再把 manifest 钉死，
                防止将来有人（包括我）在别处重新引入 task-removed 行为。
            -->
            <!--
                用户口径（2026-11-27，#60）**回归上游的 MediaSessionService**。

                上一版被我改成了 `MediaLibraryService` + MEDIA_BUTTON action，
                目的只有一个：让 App 彻底关闭时系统控制中心的播放键也亮着。
                但用户明确说不需要这个：
                「现在我不需要音乐组件在 APP 不在后台的时候显示播放按钮……
                  其余的不用 APP 不在后台的时候，非要在它上面显示了」

                那套改动带来两个副作用，都已坐实：
                ```
                ① 「下一首点一次跳两首」—— MusicLibrarySession 的
                   onPlayerCommandRequest 和我们自己的处理各执行了一次
                ② 「暂停不好使 / 一会儿又自己播」—— 同上，命令被处理两次
                ```
                现在 action 回到 `MediaSessionService`，上一首/下一首
                交给 MediaSession 默认处理，一次按键只切一首。

                MediaBrowserService 这个 action 保留：
                ColorOS / 部分车机靠它识别「候选音乐 App」。
            -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <!--
                    用户口径（#69）**Service 自己也注册 MEDIA_BUTTON**（照 QQ 音乐）。

                    adb 实测对比 QQ 音乐 com.tencent.qqmusic：
                    ```
                    Receiver: androidx.media.session.MediaButtonReceiver
                    Service:  QQPlayerServiceNew  Action: "android.intent.action.MEDIA_BUTTON"
                    ```
                    它让媒体键在进程刚启动时就有一个静态入口可接命令。
                -->
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>
    </application>
</manifest>
